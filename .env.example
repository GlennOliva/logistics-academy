# Browser-safe values only
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
VITE_APP_ORIGIN=http://localhost:5173
VITE_EMAIL_DELIVERY_ENABLED=false

# Edge Function secrets (set with `supabase secrets set`; never prefix with VITE_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_ORIGINS=http://localhost:5173,https://your-domain.example
CERTIFICATE_RATE_LIMIT_SALT=generate-a-long-random-secret
PUBLIC_APP_ORIGIN=https://your-domain.example
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=configure-after-provider-selection
EMAIL_FROM=verified-sender@example.com
EMAIL_WORKER_SECRET=generate-a-long-random-secret
